              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviews Count"
          },
          "coordinates": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Coordinates"
              },
              {
                "type": "null"
              }
            ]
          },
          "hours": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Hours"
              },
              {
                "type": "null"
              }
            ]
          },
          "is_claimed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Claimed"
          },
          "enrichment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Enrichment"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "place_id",
          "name"
        ],
        "title": "BusinessResult"
      },
      "Coordinates": {
        "properties": {
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lng": {
            "type": "number",
            "title": "Lng"
          }
        },
        "type": "object",
        "required": [
          "lat",
          "lng"
        ],
        "title": "Coordinates"
